{
  "dependencies": [
    "torch"
  ],
  "cases": [
    {
      "name": "mixed mask",
      "inputs": {
        "values": [
          [
            1,
            -2,
            3
          ],
          [
            4,
            5,
            -6
          ]
        ],
        "shape": [
          2,
          3
        ],
        "mask": [
          [
            true,
            false,
            true
          ],
          [
            false,
            true,
            false
          ]
        ],
        "replacement": -7,
        "dtype": "float32"
      },
      "expected": {
        "values": [
          -7,
          -2,
          -7,
          4,
          -7,
          -6
        ]
      }
    },
    {
      "name": "all false",
      "inputs": {
        "values": [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ],
        "shape": [
          2,
          2
        ],
        "mask": [
          [
            false,
            false
          ],
          [
            false,
            false
          ]
        ],
        "replacement": -9,
        "dtype": "float64"
      },
      "expected": {
        "values": [
          1,
          2,
          3,
          4
        ]
      }
    },
    {
      "name": "all true",
      "inputs": {
        "values": [
          1,
          -2,
          3
        ],
        "shape": [
          3
        ],
        "mask": [
          true,
          true,
          true
        ],
        "replacement": 5,
        "dtype": "int32"
      },
      "expected": {
        "values": [
          5,
          5,
          5
        ]
      }
    },
    {
      "name": "empty mask",
      "inputs": {
        "values": [
          [],
          []
        ],
        "shape": [
          2,
          0
        ],
        "mask": [
          [],
          []
        ],
        "replacement": 2,
        "dtype": "float32"
      },
      "expected": {
        "values": []
      }
    },
    {
      "name": "singleton axes",
      "inputs": {
        "values": [
          [
            [
              1,
              2
            ]
          ]
        ],
        "shape": [
          1,
          1,
          2
        ],
        "mask": [
          [
            [
              true,
              false
            ]
          ]
        ],
        "replacement": 0.5,
        "dtype": "float64"
      },
      "expected": {
        "values": [
          0.5,
          2
        ]
      }
    },
    {
      "name": "input is a strided view",
      "inputs": {
        "values": [
          [
            1,
            3
          ],
          [
            4,
            6
          ]
        ],
        "shape": [
          2,
          2
        ],
        "base": [
          [
            1,
            2,
            3
          ],
          [
            4,
            5,
            6
          ]
        ],
        "base_shape": [
          2,
          3
        ],
        "mask": [
          [
            true,
            false
          ],
          [
            false,
            true
          ]
        ],
        "replacement": -7,
        "dtype": "int64"
      },
      "expected": {
        "values": [
          -7,
          3,
          4,
          -7
        ],
        "base": [
          [
            -7,
            2,
            3
          ],
          [
            4,
            5,
            -7
          ]
        ]
      }
    }
  ]
}

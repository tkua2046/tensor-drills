{
  "dependencies": ["numpy"],
  "cases": [
    {
      "name": "unsorted repeated indices",
      "inputs": {
        "matrix": [
          [10, 11, 12, 13],
          [20, 21, 22, 23],
          [30, 31, 32, 33]
        ],
        "rows": [2, 0, 2, 1],
        "columns": [3, 1, 0, 3],
        "dtype": "int32"
      },
      "expected": [
        [33, 11, 30, 23],
        [
          [33, 31, 30, 33],
          [13, 11, 10, 13],
          [33, 31, 30, 33],
          [23, 21, 20, 23]
        ]
      ]
    },
    {
      "name": "rectangular matrix",
      "inputs": {
        "matrix": [
          [0.5, 1.5],
          [2.5, -3.5],
          [4.5, 5.5]
        ],
        "rows": [2, 1],
        "columns": [1, 0],
        "dtype": "float32"
      },
      "expected": [
        [5.5, 2.5],
        [
          [5.5, 4.5],
          [-3.5, 2.5]
        ]
      ]
    },
    {
      "name": "one index pair",
      "inputs": {
        "matrix": [
          [2, 4, 6],
          [8, 10, 12]
        ],
        "rows": [1],
        "columns": [2],
        "dtype": "int64"
      },
      "expected": [
        [12],
        [
          [12]
        ]
      ]
    }
  ]
}

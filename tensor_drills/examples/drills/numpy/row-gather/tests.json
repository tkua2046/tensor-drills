{
  "dependencies": ["numpy"],
  "cases": [
    {
      "name": "rectangular array",
      "inputs": {"scores": [[10, 20, 30], [40, 50, 60]], "shape": [2, 3], "dtype": "int16", "columns": [2, 0]},
      "expected": [30, 40]
    },
    {
      "name": "repeated columns",
      "inputs": {"scores": [[0.25, 1.5], [2.25, 3.5], [4.25, 5.5]], "shape": [3, 2], "dtype": "float32", "columns": [1, 1, 0]},
      "expected": [1.5, 3.5, 4.25]
    },
    {
      "name": "empty batch",
      "inputs": {"scores": [], "shape": [0, 3], "dtype": "float64", "columns": []},
      "expected": []
    },
    {
      "name": "one column",
      "inputs": {"scores": [[7], [9], [4]], "shape": [3, 1], "dtype": "int32", "columns": [0, 0, 0]},
      "expected": [7, 9, 4]
    },
    {
      "name": "one row",
      "inputs": {"scores": [[1.25, -3.5, 4.75]], "shape": [1, 3], "dtype": "float32", "columns": [1]},
      "expected": [-3.5]
    }
  ]
}

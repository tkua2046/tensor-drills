{
  "dependencies": ["numpy"],
  "cases": [
    {
      "name": "three distinct axes",
      "inputs": {
        "values": [
          [
            [1, 2, 4, 5],
            [-8, 4, 2, 6],
            [20, 4, 0, -4]
          ],
          [
            [6, 8, 9, 13],
            [-1, 3, 10, 12],
            [1, -3, 7, -1]
          ]
        ],
        "dtype": "float32"
      },
      "expected": [
        [48, 28, 24],
        [
          [
            [6],
            [3.5],
            [3]
          ]
        ],
        [
          [
            [-5, -4, -2, -1],
            [-11.5, 0.5, -1.5, 2.5],
            [17, 1, -3, -7]
          ],
          [
            [0, 2, 3, 7],
            [-4.5, -0.5, 6.5, 8.5],
            [-2, -6, 4, -4]
          ]
        ]
      ]
    },
    {
      "name": "one middle position",
      "inputs": {
        "values": [
          [
            [0, 3]
          ],
          [
            [4, -2]
          ],
          [
            [1, 1]
          ]
        ],
        "dtype": "float64"
      },
      "expected": [
        [7],
        [
          [
            [1.1666666666666667]
          ]
        ],
        [
          [
            [-1.1666666666666667, 1.8333333333333333]
          ],
          [
            [2.8333333333333335, -3.1666666666666665]
          ],
          [
            [-0.16666666666666666, -0.16666666666666666]
          ]
        ]
      ]
    },
    {
      "name": "singleton reduced axes",
      "inputs": {
        "values": [
          [
            [-3],
            [5]
          ]
        ],
        "dtype": "float32"
      },
      "expected": [
        [-3, 5],
        [
          [
            [-3],
            [5]
          ]
        ],
        [
          [
            [0],
            [0]
          ]
        ]
      ]
    }
  ]
}

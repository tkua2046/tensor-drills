{
  "dependencies": ["torch"],
  "cases": [
    {
      "name": "rectangular tensor",
      "inputs": {
        "scores": [
          [10, 20, 30],
          [40, 50, 60]
        ],
        "shape": [2, 3],
        "dtype": "float32",
        "columns": [2, 0]
      },
      "expected": [30, 40]
    },
    {
      "name": "repeated columns",
      "inputs": {
        "scores": [
          [3, 8],
          [10, 15],
          [21, 33]
        ],
        "shape": [3, 2],
        "dtype": "int32",
        "columns": [1, 1, 0]
      },
      "expected": [8, 15, 21]
    },
    {
      "name": "empty batch",
      "inputs": {
        "scores": [],
        "shape": [0, 4],
        "dtype": "float64",
        "columns": []
      },
      "expected": []
    },
    {
      "name": "one row",
      "inputs": {
        "scores": [
          [2, 4, 6]
        ],
        "shape": [1, 3],
        "dtype": "int64",
        "columns": [1]
      },
      "expected": [4]
    },
    {
      "name": "one column",
      "inputs": {
        "scores": [
          [9.5],
          [-4.25],
          [7.75]
        ],
        "shape": [3, 1],
        "dtype": "float64",
        "columns": [0, 0, 0]
      },
      "expected": [9.5, -4.25, 7.75]
    }
  ]
}
